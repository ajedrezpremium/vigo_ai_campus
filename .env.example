# App
NEXT_PUBLIC_APP_NAME="VIGO AI CAMPUS"
NEXT_PUBLIC_APP_URL="https://vigo-ai-campus.vercel.app"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
ADMIN_EMAILS=""

# OpenRouter (modelos free)
LLM_PROVIDER="openrouter"
LLM_API_KEY=""
LLM_MODEL="google/gemma-4-31b-it:free"
LLM_MODELS="nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free,xingchen-agi/xing4.0-29b-a4b:free,openrouter/free"
AI_MAX_OUTPUT_TOKENS="900"
AI_DAILY_REQUEST_LIMIT="30"
LLM_SKIP_ON_QUOTA="true"

# Modo demo (sin Supabase): por defecto el visitante es estudiante.
# Pon "true" solo en local para explorar /admin sin cuenta.
DEMO_ADMIN="false"

# Rate limiting distribuido (opcional; recomendado en producción)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Integraciones UVigo (requieren convenio)
UVIGO_SEDE_BASE_URL=""
UVIGO_SEDE_API_KEY=""
UVIGO_SECRETARIA_BASE_URL=""
UVIGO_SECRETARIA_API_KEY=""
UVIGO_CAMPUS_REMOTO_BASE_URL=""
UVIGO_CAMPUS_REMOTO_API_KEY=""
UVIGO_WEBHOOK_SECRET=""
CRON_SECRET=""
